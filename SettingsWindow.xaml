<Window x:Class="SunsteadLauncher.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="272" SizeToContent="Height"
        Icon="pack://application:,,,/logo.ico"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False"
        FontFamily="Fonts/#Product Sans">

    <Border CornerRadius="14" Margin="8">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FF171A28" Offset="0"/>
                <GradientStop Color="#FF0B0D14" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="5" Opacity="0.55"/>
        </Border.Effect>
        <Border BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="14">
            <StackPanel Margin="18,14,18,16">

                <Grid MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <TextBlock Text="Settings" FontFamily="Fonts/#Product Sans" FontWeight="Bold"
                               FontSize="14" Foreground="{StaticResource TextHi}"/>
                    <Button Style="{StaticResource WinButton}" Content="✕" HorizontalAlignment="Right"
                            Margin="0,-4,-6,0" Click="Close_Click"/>
                </Grid>

                <CheckBox x:Name="OptAutoUpdate" Content="Auto-update on Launch"
                          IsChecked="True" Margin="0,14,0,0"
                          Foreground="{StaticResource TextHi}" FontSize="13" Cursor="Hand"
                          Focusable="False"/>
                <CheckBox x:Name="OptForceDownload" Content="Force re-download"
                          Margin="0,10,0,0"
                          Foreground="{StaticResource TextHi}" FontSize="13" Cursor="Hand"
                          Focusable="False"/>

                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <Button x:Name="CheckBtn" Content="Check updates" Cursor="Hand" Focusable="False"
                            Click="CheckUpdates_Click" FontFamily="Fonts/#Product Sans" FontSize="12.5"
                            Foreground="{StaticResource TextHi}" Padding="12,7"
                            Background="#1AFFFFFF" BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" CornerRadius="8" Background="{TemplateBinding Background}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="#2AFFFFFF"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="#3AFFFFFF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Content="Open DLL folder" Cursor="Hand" Focusable="False"
                            Click="OpenFolder_Click" Margin="8,0,0,0"
                            FontFamily="Fonts/#Product Sans" FontSize="12.5"
                            Foreground="{StaticResource TextHi}" Padding="12,7"
                            Background="#1AFFFFFF" BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" CornerRadius="8" Background="{TemplateBinding Background}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="#2AFFFFFF"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="#3AFFFFFF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>
    </Border>
</Window>

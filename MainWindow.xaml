<Window x:Class="SunsteadLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sunstead Launcher" Width="400" Height="276"
        Icon="pack://application:,,,/logo.ico"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ShowActivated="True"
        FontFamily="Fonts/#Product Sans"
        Foreground="{StaticResource TextHi}"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <!-- Slim progress bar -->
        <ControlTemplate x:Key="SlimProgress" TargetType="ProgressBar">
            <Border CornerRadius="2.5" Background="#14FFFFFF" ClipToBounds="True">
                <Grid>
                    <Border x:Name="PART_Track"/>
                    <Border x:Name="PART_Indicator" CornerRadius="2.5" HorizontalAlignment="Left"
                            Background="{TemplateBinding Foreground}"/>
                    <Rectangle x:Name="Sweep" Width="56" Visibility="Collapsed" IsHitTestVisible="False">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#00F5A623" Offset="0"/>
                                <GradientStop Color="#FF38BDF8" Offset="0.5"/>
                                <GradientStop Color="#00FFC86B" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                        <Rectangle.RenderTransform>
                            <TranslateTransform x:Name="SweepTf" X="-60"/>
                        </Rectangle.RenderTransform>
                    </Rectangle>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsIndeterminate" Value="True">
                    <Setter TargetName="Sweep" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="PART_Indicator" Property="Width" Value="0"/>
                    <Trigger.EnterActions>
                        <BeginStoryboard x:Name="SweepStory">
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimation Storyboard.TargetName="SweepTf"
                                                 Storyboard.TargetProperty="X"
                                                 From="-60" To="420" Duration="0:0:1.4"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <RemoveStoryboard BeginStoryboardName="SweepStory"/>
                    </Trigger.ExitActions>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- LAUNCH button -->
        <ControlTemplate x:Key="LaunchTemplate" TargetType="Button">
            <Grid RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="Sc"/>
                </Grid.RenderTransform>
                <Ellipse x:Name="Glow" Fill="#2838BDF8" Margin="-16" Opacity="0.5"/>
                <Border x:Name="Bg" CornerRadius="16" Background="{TemplateBinding Background}">
                    <Border.Effect>
                        <DropShadowEffect Color="#38BDF8" BlurRadius="30" ShadowDepth="0" Opacity="0.4"/>
                    </Border.Effect>
                    <Grid>
                        <!-- gloss -->
                        <Border CornerRadius="16,16,10,10" VerticalAlignment="Top" Height="22"
                                Background="#26FFFFFF" IsHitTestVisible="False"/>
                        <TextBlock Text="{TemplateBinding Content}"
                                   FontFamily="{StaticResource ProductSans}" FontWeight="Bold"
                                   FontSize="17" Foreground="#FF06263F"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX"
                                                 To="1.07" Duration="0:0:0.16">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY"
                                                 To="1.07" Duration="0:0:0.16">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity"
                                                 To="0.95" Duration="0:0:0.16"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX"
                                                 To="1" Duration="0:0:0.22">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY"
                                                 To="1" Duration="0:0:0.22">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity"
                                                 To="0.5" Duration="0:0:0.22"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="Bg" Property="Background" Value="#FF2A2D38"/>
                    <Setter TargetName="Bg" Property="Effect" Value="{x:Null}"/>
                    <Setter TargetName="Glow" Property="Opacity" Value="0"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="LaunchStyle" TargetType="Button">
            <Setter Property="Height" Value="52"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FF7DD3FC" Offset="0"/>
                        <GradientStop Color="#FF38BDF8" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Template" Value="{StaticResource LaunchTemplate}"/>
        </Style>

        <!-- footer link buttons -->
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextMid}"/>
            <Setter Property="FontFamily" Value="{StaticResource ProductSans}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="bg" CornerRadius="8" Background="{TemplateBinding Background}"
                                    Padding="11,5">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border x:Name="ul" Height="2" CornerRadius="1" Width="30" Opacity="0"
                                    HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,1"
                                    Background="#FF38BDF8">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="ulScale" ScaleX="0"/>
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#22FFFFFF"/>
                                <Setter Property="Foreground" Value="{StaticResource TextHi}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ul" Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.16"/>
                                            <DoubleAnimation Storyboard.TargetName="ulScale" Storyboard.TargetProperty="ScaleX"
                                                             To="1" Duration="0:0:0.22">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ul" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="ulScale" Storyboard.TargetProperty="ScaleX"
                                                             To="0" Duration="0:0:0.16"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Main card -->
        <Border x:Name="Card" CornerRadius="18" Margin="8">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FF171A28" Offset="0"/>
                    <GradientStop Color="#FF0B0D14" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="5" Opacity="0.55"/>
            </Border.Effect>
            <Border BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Height="48" Background="Transparent"
                          MouseLeftButtonDown="Header_MouseLeftButtonDown">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                            <Ellipse Width="11" Height="11" Fill="#FF38BDF8" VerticalAlignment="Center">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#38BDF8" BlurRadius="12" ShadowDepth="0" Opacity="0.8"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <TextBlock Text="Sunstead" FontFamily="Fonts/#Product Sans" FontWeight="Bold"
                                       FontSize="15" Foreground="{StaticResource TextHi}"
                                       VerticalAlignment="Center" Margin="10,1,0,0"/>
                            <Border CornerRadius="9" Background="#14FFFFFF" Padding="9,3" Margin="10,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="VersionPill" Text="..."
                                           FontFamily="Fonts/#Product Sans" FontSize="11"
                                           Foreground="{StaticResource TextMid}"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,12,0">
                            <ToggleButton x:Name="SettingsToggle" Style="{StaticResource SettingsButton}"
                                          Content="⚙" Click="Settings_Click"/>
                            <Button Style="{StaticResource WinButton}" Content="—" Margin="6,0,0,0"
                                    Click="Minimize_Click"/>
                            <Button Style="{StaticResource CloseButton}" Content="✕" Margin="6,0,0,0"
                                    Click="Close_Click"/>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="0" Height="1" VerticalAlignment="Bottom" Margin="16,0"
                            Background="#14FFFFFF"/>

                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                        <Button x:Name="LaunchBtn" Style="{StaticResource LaunchStyle}"
                                Content="LAUNCH" Width="300"
                                Click="Launch_Click" MouseRightButtonUp="Launch_RightClick"/>
                        <TextBlock Text="LMB — update &amp; inject      RMB — custom DLL"
                                   FontFamily="Fonts/#Product Sans" FontSize="11"
                                   Foreground="{StaticResource TextMid}" Opacity="0.75"
                                   HorizontalAlignment="Center" Margin="0,13,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="20,0,20,12">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="8" Height="8"
                                     Fill="{StaticResource TextMid}" VerticalAlignment="Center">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#FFFFFF" BlurRadius="0" ShadowDepth="0" Opacity="0"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <TextBlock x:Name="StatusText" Text="Ready."
                                       FontFamily="Fonts/#Product Sans" FontSize="12.5"
                                       Foreground="{StaticResource TextMid}"
                                       VerticalAlignment="Center" Margin="9,0,0,0"
                                       TextTrimming="CharacterEllipsis" MaxWidth="330"/>
                        </StackPanel>
                        <ProgressBar x:Name="Progress" Height="5" Minimum="0" Maximum="1"
                                     Template="{StaticResource SlimProgress}"
                                     Foreground="#FF38BDF8" Visibility="Collapsed" Margin="1,9,1,0"/>
                    </StackPanel>

                    <Grid Grid.Row="3" Margin="14,0,14,10">
                        <Border Height="1" VerticalAlignment="Top" Margin="6,0" Background="#14FFFFFF"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,9,0,0">
                            <Button Style="{StaticResource LinkButton}" Click="Discord_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="17" Height="13" Stretch="Uniform" VerticalAlignment="Center"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Data="M107.7,8.07A105.15,105.15,0,0,0,81.47,0a72.06,72.06,0,0,0-3.36,6.83A97.68,97.68,0,0,0,49,6.83,72.37,72.37,0,0,0,45.64,0,105.89,105.89,0,0,0,19.39,8.09C2.79,32.65-1.71,56.6.54,80.21h0A105.73,105.73,0,0,0,32.71,96.36,77.7,77.7,0,0,0,39.6,85.25a68.42,68.42,0,0,1-10.85-5.18c.91-.66,1.8-1.34,2.66-2a75.57,75.57,0,0,0,64.32,0c.87.71,1.76,1.39,2.66,2a68.68,68.68,0,0,1-10.87,5.19,77,77,0,0,0,6.89,11.1A105.25,105.25,0,0,0,126.6,80.22h0C129.24,52.84,122.09,29.11,107.7,8.07ZM42.45,65.69C36.18,65.69,31,60,31,53s5-12.74,11.43-12.74S54,46,53.89,53,48.84,65.69,42.45,65.69Zm42.24,0C78.41,65.69,73.25,60,73.25,53s5-12.74,11.44-12.74S96.23,46,96.12,53,91.08,65.69,84.69,65.69Z"/>
                                    <TextBlock Text="Discord" VerticalAlignment="Center" Margin="7,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource LinkButton}" Margin="8,0,0,0" Click="Changelog_Click">
                                <TextBlock Text="Changelog" VerticalAlignment="Center"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>
